# Required
BOT_TOKEN=your_telegram_bot_token_here

# Optional
EMAILREP_KEY=optional_emailrep_io_key
ADMIN_CHAT_ID=your_telegram_chat_id_for_alerts
BATCH_SIZE=5

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Payment provider tokens (set via /setpayment command in bot)
# CRYPTOBOT_TOKEN=crypto_pay_token
# HELEKET_API_KEY=heleket_key
# HELEKET_SECRET=heleket_secret
# BTCPAY_BASE_URL=https://your.btcpay.server
# BTCPAY_API_KEY=btcpay_api_key
# BTCPAY_STORE_ID=btcpay_store_id
# BTCPAY_WEBHOOK_IPS=1.2.3.4,5.6.7.8  # comma-separated IPs allowed for BTCPay webhooks

# Usfull.pro API key (set via /setufkey command in bot)
# USFULL_API_KEY=your_usfull_pro_api_key