# SBBot v3 — Environment Variables
# Copy to .env and fill in real values

# ── Telegram ─────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# ── Usfull.pro ─────────────────────────────────────────────────────
# API key from usfull.pro dashboard
USFULL_API_KEY=

# ── Enformion ────────────────────────────────────────────────────
# Account credentials (email:password, one per line)
# ENF_ACCOUNTS_FILE=./data/enf_accounts.txt

# ── Payments ────────────────────────────────────────────────────
# CryptoBot token from @CryptoBot
CRYPTOBOT_TOKEN=

# Heleket
HELEKET_API_KEY=
HELEKET_MERCHANT_ID=

# BTCPayServer
BTCPAY_BASE_URL=https://your.btcpay.example.com
BTCPAY_API_KEY=
BTCPAY_STORE_ID=

# ── Admin ────────────────────────────────────────────────────────
# Restrict admin panel to specific user IDs (comma-separated)
ADMIN_USER_IDS=
# Secret for admin panel (change this!)
ADMIN_SECRET=change-me-to-a-random-string

# ── Database ──────────────────────────────────────────────────
# DB is SQLite at data/bot.db (auto-created)

# ── Server ────────────────────────────────────────────────────
# Host/port for webhooks and API
HOST=0.0.0.0
API_PORT=3111
ADMIN_PORT=3111
