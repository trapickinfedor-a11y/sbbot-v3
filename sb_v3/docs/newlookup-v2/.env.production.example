# ========== REQUIRED VARIABLES ==========

# Database Configuration
POSTGRES_USER=newlookup
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=newlookup
DATABASE_URL=postgresql+asyncpg://newlookup:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/newlookup

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD_HERE@redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD_HERE@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD_HERE@redis:6379/2
CELERY_TIMEZONE=UTC
CELERY_AUTO_COMPLETE_INTERVAL_MINUTES=5
CELERY_VIOLATION_CHECK_INTERVAL_MINUTES=60

# Bot Tokens (get from @BotFather on Telegram)
MAIN_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
MAIN_BOT_USERNAME=your_main_bot
SUPPORT_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
WORKER_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
SELLER_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
MARKETER_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin Configuration
ADMIN_IDS=123456789,987654321
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_HERE

# Security Keys (generate with: openssl rand -hex 32)
WEB_PANEL_SECRET_KEY=CHANGE_ME_64_CHAR_SECRET_KEY_HERE
INTERNAL_API_TOKEN=CHANGE_ME_32_CHAR_API_TOKEN_HERE
LOOKUP_ADMIN_TOKEN=CHANGE_ME_32_CHAR_LOOKUP_TOKEN_HERE

# Telegram Channels
ORDERS_CHANNEL_ID=-1001234567890

# Web Panel Configuration
WEB_PANEL_PORT=8000
SELLER_MINI_APP_URL=https://your-domain.com/seller-app

# Lookup API Configuration
LOOKUP_API_PORT=8082
LOOKUP_DB_PATH=/app/data/lookup.db
PRICE_SSN_FOUND=0.40
PRICE_SSN_NOFOUND=0.01
PRICE_DL_FOUND=1.00
PRICE_DL_NOFOUND=0.00

# ========== OPTIONAL VARIABLES ==========

# Tasks Database (SQLite for development)
TASKS_DATABASE_URL=sqlite+aiosqlite:////app/data/tasks.db

# Worker Bot Internal API
WORKER_BOT_API_URL=http://worker_bot:8181
MAIN_BOT_API_URL_INTERNAL=http://main_bot:8080

# Monitoring (optional)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Alerts (optional)
ALERT_EMAIL=admin@your-domain.com
ALERT_WEBHOOK=https://your-webhook-url.com/alerts

# Backup Configuration (optional)
AWS_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret

# ========== GENERATION COMMANDS ==========
# Generate secure passwords:
#   openssl rand -base64 32
#   openssl rand -hex 32
#
# Get your Telegram ID:
#   Send /start to @userinfobot
#
# Create bot tokens:
#   Talk to @BotFather on Telegram
#
# Create channel:
#   1. Create a channel on Telegram
#   2. Add your bot as admin
#   3. Forward a message from channel to @userinfobot to get ID
