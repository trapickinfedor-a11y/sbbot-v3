# Lookup API Configuration

# Database path
LOOKUP_DB_PATH=/Users/user/Desktop/прокты/newlookup/data/lookup.db

# Admin token for admin endpoints
LOOKUP_ADMIN_TOKEN=changeme-set-LOOKUP_ADMIN_TOKEN

# Server configuration
LOOKUP_API_HOST=0.0.0.0
LOOKUP_API_PORT=8001

# Pricing (compatible with usfull.info)
PRICE_SSN_FOUND=0.40
PRICE_SSN_NOFOUND=0.01
PRICE_DL_FOUND=1.00
PRICE_DL_NOFOUND=0.00
PRICE_CR_FOUND=0.40
PRICE_CR_NOFOUND=0.01

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
