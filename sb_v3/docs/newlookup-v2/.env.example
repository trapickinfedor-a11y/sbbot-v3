# ─── Self-hosted Lookup API ─────────────────────────────────────────────────
# Set LOOKUP_API_BASE_URL to http://lookup_api:8082 to use the self-hosted backend
# instead of usfull.pro (leave empty or set to https://usfull.pro for external API)
LOOKUP_API_BASE_URL=http://lookup_api:8082
LOOKUP_API_PORT=8082
LOOKUP_ADMIN_TOKEN=change_me_lookup_admin_token

# Prices charged per successful/failed lookup (in USD)
PRICE_SSN_FOUND=0.40
PRICE_SSN_NOFOUND=0.01
PRICE_DL_FOUND=1.00
PRICE_DL_NOFOUND=0.00

# Disable automation runners (set to 1 to disable)
DISABLE_SSNDL_AUTOMATION=0
DISABLE_CR_AUTOMATION=0
# Keep old Playwright CS runner disabled once CR API is populated:
DISABLE_CS_AUTOMATION=1

# Prices for Credit Report API calls
PRICE_CR_FOUND=0.40
PRICE_CR_NOFOUND=0.01
