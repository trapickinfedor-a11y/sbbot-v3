# Metabase Environment Configuration
# Copy this file to .env.metabase and update values

# ========== Metabase Internal Database ==========
# These credentials are for Metabase's own database (stores dashboards, users, etc.)

METABASE_DB_USER=metabase
METABASE_DB_PASS=metabase_secret_password_change_me
METABASE_DB_NAME=metabase
METABASE_DB_HOST=metabase-db
METABASE_DB_PORT=5432

# ========== Metabase Admin Account ==========
# Set these during initial setup or via environment

# MB_EMAIL=admin@newlookup.com
# MB_PASSWORD=secure_admin_password_change_me
# MB_FIRST_NAME=Admin
# MB_LAST_NAME=User

# ========== Java/Memory Settings ==========
# Adjust based on your server resources

JAVA_OPTS=-Xmx2g -Xms2g

# ========== Timezone & Locale ==========

JAVA_TIMEZONE=UTC
MB_JETTY_PORT=3000
MB_JETTY_HOST=0.0.0.0

# ========== SSL (disable if using nginx proxy) ==========

MB_NO_SSL=true

# ========== Email/SMTP Configuration (for alerts & reports) ==========
# Uncomment and configure to enable email notifications

# MB_EMAIL_SMTP_HOST=smtp.gmail.com
# MB_EMAIL_SMTP_PORT=587
# MB_EMAIL_SMTP_USERNAME=your-email@gmail.com
# MB_EMAIL_SMTP_PASSWORD=your-app-password
# MB_EMAIL_FROM_ADDRESS=analytics@newlookup.com
# MB_EMAIL_FROM_NAME=NewLookup Analytics

# ========== Slack Integration (for alerts) ==========
# Uncomment and add your Slack webhook URL

# MB_SLACK_TOKEN=xoxb-your-bot-token
# MB_SLACK_APP_ID=A0123456789

# ========== Google Analytics (optional) ==========

# MB_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# ========== Maxmind Geolocation (optional) ==========

# MB_MAXMIND_LICENSE_KEY=your-license-key

# ========== Application Database (NewLookup) ==========
# These are used to connect Metabase to your main database

# Reference from main .env file:
# POSTGRES_USER=newlookup
# POSTGRES_PASSWORD=your_password
# POSTGRES_DB=newlookup
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
